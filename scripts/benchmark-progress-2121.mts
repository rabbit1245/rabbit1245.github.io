import {pathToFileURL} from 'node:url';import {performance} from 'node:perf_hooks';import {createHash} from 'node:crypto';import {writeFile} from 'node:fs/promises';
const roots={before:process.env.KBALL_BASELINE_ROOT??'/workspace/kball-2121/baseline',after:process.env.KBALL_OPTIMIZED_ROOT??'/workspace/kball-2121/performance-only'},versions=Object.fromEntries(await Promise.all(Object.entries(roots).map(async([k,r])=>[k,await import(pathToFileURL(r+'/src/game/engine.ts').href)]))),rows=[];
for(let i=0;i<3;i++)for(const k of i%2?['after','before']:['before','after']){const e=versions[k],c=e.createCareer({name:'진행 원인 검수',nationality:'대한민국',age:26,height:180,weight:78,foot:'right',position:'ST',talent:'S',style:'프레싱 포워드',clubId:'EN1_12',squad:'senior',difficulty:'realistic',seed:'progress-profile-2121',training:[]});global.gc?.();const start=performance.now(),cpu=process.cpuUsage(),n=e.advanceCareer(c,8),wallMs=performance.now()-start,used=process.cpuUsage(cpu),hash=createHash('sha256').update(JSON.stringify(n)).digest('hex');rows.push({trial:i,label:k,wallMs,cpuMs:(used.user+used.system)/1000,hash,fixtures:Object.values(n.systems.world.competitions).reduce((s:any,l:any)=>s+l.fixtures.filter((f:any)=>f.played).length,0)});console.log(k,i,wallMs);}
if(new Set(rows.map(r=>r.hash)).size!==1)throw Error('Full career outputs differ');const median=(k:string)=>rows.filter(r=>r.label===k).map(r=>r.wallMs).sort((a,b)=>a-b)[1],report={rows,fullOutputsIdentical:true,beforeMedianMs:median('before'),afterMedianMs:median('after'),reduction:1-median('after')/median('before')};await writeFile(process.env.KBALL_WORLD_REPORT??'test-results/world-performance-2121.json',JSON.stringify(report,null,2));console.log(JSON.stringify(report));
