 const c=fresh(),e=c.systems.economics;c.player.wage=500000;e.marketValue=350000000;e.peakValue=e.marketValue;e.contract={...e.contract,wageAtSigning:500000,signedYear:c.season.year,expiresYear:c.season.year+5,role:'핵심 선수'};e.assessment=assessmentNow(c);
