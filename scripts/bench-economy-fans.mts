const {createCareer}=await import(pathToFileURL(root+'/src/game/engine.ts').href),{FIELD_ATTRIBUTES,overall}=await import(pathToFileURL(root+'/src/game/attributes.ts').href),{assessmentNow}=await import(pathToFileURL(root+'/src/game/market-value.ts').href),{makeContractOffers,updateMarketValue}=await import(pathToFileURL(root+'/src/game/career-systems.ts').href),{emptyStats}=await import(pathToFileURL(root+'/src/game/math.ts').href),{ensureCommercial,settleShirtMarket}=await import(pathToFileURL(root+'/src/game/commercial.ts').href),{validateCommercial}=await import(pathToFileURL(root+'/src/game/commercial-validation.ts').href),{getClub}=await import(pathToFileURL(root+'/src/game/data.ts').href);
