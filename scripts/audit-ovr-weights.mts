import {writeFile,mkdir} from 'node:fs/promises';
import {attributeWeights,expanded2120Weights,overall,expanded2120Overall,POSITION_LABELS,ATTRIBUTE_LABELS,PLAY_STYLES,FIELD_ATTRIBUTES,GK_ATTRIBUTES} from '../src/game/attributes';import type {Position} from '../src/game/types';
const rows=[];for(const position of Object.keys(POSITION_LABELS) as Position[])for(const style of PLAY_STYLES[position]){const before=expanded2120Weights(position,style),after=attributeWeights(position,style),attributes=Object.fromEntries((position==='GK'?GK_ATTRIBUTES:FIELD_ATTRIBUTES).map(k=>[k,50]));for(const key of Object.keys(after)){const p={position,style,attributes:{...attributes,[key]:100}};rows.push({position,style,attribute:ATTRIBUTE_LABELS[key as keyof typeof ATTRIBUTE_LABELS],key,beforeWeight:before[key as keyof typeof before],afterWeight:after[key as keyof typeof after],before50:expanded2120Overall(p)-50,after50:overall(p)-50});}}
const report={profiles:160,attributes:rows.length,beforeBelowOnePer50:rows.filter(r=>r.beforeWeight!*50<1).length,afterBelowOnePer50:rows.filter(r=>r.afterWeight!*50<1).length,minimumFieldWeight:Math.min(...rows.filter(r=>r.position!=='GK').map(r=>r.afterWeight!)),maximumFieldWeight:Math.max(...rows.filter(r=>r.position!=='GK').map(r=>r.afterWeight!)),rows};const out=process.argv[2]??'test-results/weights-2121';await mkdir(out,{recursive:true});await writeFile(`${out}/weights-audit.json`,JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({...report,rows:undefined}));
