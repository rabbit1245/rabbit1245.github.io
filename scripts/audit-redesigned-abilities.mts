import {mkdir,writeFile} from 'node:fs/promises';
import {createCareer} from '../src/game/engine';
import {FIELD_ATTRIBUTES,GK_ATTRIBUTES,PLAY_STYLES,overall,overallParts,attributeWeights} from '../src/game/attributes';
import {simulateMatch} from '../src/game/match-engine';
import {emptyStats,addStats} from '../src/game/math';
import {getClub} from '../src/game/data';
import {validateActionLedger} from '../src/game/action-metrics';
import type {Position,AttributeKey,PlayerStats,Career} from '../src/game/types';
const samples=Number(process.env.KBALL_AUDIT_MATCHES??400),out=process.env.KBALL_AUDIT_OUT??'test-results/redesign-2130/ability-links.json';
const positions:Position[]=['GK','CB','CB','LB','RB','CDM','CM','CAM','LW','RW','ST','CM','CB'];
const roster=(clubId:string)=>positions.map((position,i)=>({clubId,id:`${clubId}:test:${i}`,position,ovr:80,name:`능력 검수 ${i}`}));
const fixture={id:'redesign-links',round:1,homeId:'EN1_12',awayId:'EN1_13',played:false};
const opts={home:{...getClub('EN1_12'),power:80},away:{...getClub('EN1_13'),power:80},homePlayers:roster('EN1_12'),awayPlayers:roster('EN1_13'),detailed:false,forceSelection:{from:0,to:90,started:true}};
function fresh(position:Position,level=80){const c=createCareer({name:'전체 능력 연동',nationality:'포르투갈',age:27,height:184,weight:80,foot:'right',position,talent:'SSS',style:PLAY_STYLES[position][0],clubId:'EN1_12',squad:'senior',difficulty:'realistic',seed:'redesign-links-2130',training:[]});c.player.attributes=Object.fromEntries((position==='GK'?GK_ATTRIBUTES:FIELD_ATTRIBUTES).map(k=>[k,level]));c.player.ovr=overall(c.player);return c;}
function probe(c:Career){let goals=0,against=0,points=0;const stats=emptyStats();for(let i=0;i<samples;i++){const m=simulateMatch({...c,seed:`paired-redesign-${i}`},fixture,opts);if(i<8)validateActionLedger(m,c.player.id);addStats(stats,m.playerStats);goals+=m.homeGoals;against+=m.awayGoals;points+=m.homeGoals>m.awayGoals?3:m.homeGoals===m.awayGoals?1:0;}return {ovr:c.player.ovr,parts:overallParts(c.player),stats,teamGoals:goals,teamConceded:against,points,per38:Object.fromEntries(['goals','assists','shots','keyPasses','tackles','interceptions','saves','pressingSuccesses','progressivePasses','headerGoals','bigChancesCreated'].map(k=>[k,Number(((stats[k as keyof PlayerStats]??0)*38/samples).toFixed(2))]))};}
const links:[AttributeKey,Position,(keyof PlayerStats)[],number?][]=[
 ['strength','CB',['aerialWon']],['stamina','CM',['lateActions']],['speed','RW',['dribbleAttempts']],['agility','CAM',['dribblesCompleted']],['jumping','CB',['aerialWon']],
 ['ballControl','CM',['passesCompleted']],['dribbling','RW',['dribblesCompleted']],['passing','CM',['passesCompleted']],['crossing','RW',['assists']],['shooting','ST',['shotsOnTarget']],['heading','ST',['headerGoals']],['defending','CB',['tackles']],['setPieces','CAM',['freeKickGoals']],
 ['decisions','CM',['passesCompleted']],['vision','CAM',['keyPasses']],['anticipation','CB',['interceptions']],['positioning','CB',['interceptions']],['composure','ST',['goals']],['concentration','CM',['passesCompleted']],['teamwork','CM',['passes']],
 ['finishing','ST',['goals']],['offTheBall','ST',['shots']],['pressing','ST',['pressingSuccesses']],['tackling','CB',['tackles']],['skillMoves','CAM',['dribblesCompleted']],
 ['gkShotStopping','GK',['saves']],['gkReflexes','GK',['saves']],['gkHandling','GK',['handlingSuccesses']],['gkAerialCommand','GK',['crossesCaught','punches']],['gkOneOnOnes','GK',['oneOnOneSaves']],['gkPositioning','GK',['sweepingSuccesses']],['gkDistribution','GK',['buildUpCompleted']],['gkDefensiveOrganization','GK',['goalsConceded'],-1],['decisions','GK',['sweepingSuccesses']],['concentration','GK',['handlingSuccesses']],
];
const results=[];for(const [key,position,metrics,direction=1]of links){const low=fresh(position),high=fresh(position);low.player.attributes[key]=40;high.player.attributes[key]=100;const a=probe(low),b=probe(high),sum=(p:typeof a)=>metrics.reduce((n,k)=>n+(p.stats[k]??0),0),pass=(sum(b)-sum(a))*direction>0;results.push({key,position,metrics,direction,low:sum(a),high:sum(b),displayOvrHeldConstant:80,pass});console.log(key,position,sum(a),'→',sum(b),pass?'PASS':'FAIL');}
const tiers:Record<string,unknown>={};for(const position of ['ST','RW','CAM','CB','RWB','GK']as Position[]){const rows=[];for(const level of [80,90,95,100,110,120,130]){const c=fresh(position,Math.min(100,level));if(level>100){const chosen=Object.entries(attributeWeights(position,c.player.style)).sort((a,b)=>b[1]!-a[1]!).slice(0,5).map(([k])=>k as AttributeKey);c.player.playSkills=chosen;for(const k of chosen)c.player.attributes[k]=level===110?110:120;c.player.skillMastery=Object.fromEntries(chosen.map(k=>[k,level===130?20:0]));}c.player.ovr=overall(c.player);rows.push({requestedTier:level,...probe(c)});}tiers[position]=rows;console.log('TIERS',position,JSON.stringify(rows.map((r:any)=>({ovr:r.ovr,...r.per38,teamGF:r.teamGoals*38/samples,teamGA:r.teamConceded*38/samples,points38:r.points*38/samples}))));}
await mkdir(out.slice(0,out.lastIndexOf('/')),{recursive:true});await writeFile(out,JSON.stringify({samples,notes:'Paired seeds; fixed 80 display OVR for single-ability isolation; actual recomposed OVR for tiers. 80-rated teammates and opposition. Full match events remain the source.',links:results,tiers},null,2)+'\n');if(results.some(r=>!r.pass))process.exitCode=1;
